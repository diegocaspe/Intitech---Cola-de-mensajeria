# Secretos: el .env real nunca se sube; la plantilla .env.example sí
.env
.env.*
# secretos del servidor en la nube (los sube deploy/subir_env.ps1)
.env.production
!.env.example
# claves SSH (la del servidor vive en ~/.ssh, nunca en el proyecto)
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# Logs
*.log

# Bases de datos locales y datos generados al ejecutar (la base de datos real vive en el contenedor de PostgreSQL)
data/
*.db
*.sqlite
*.sqlite3

# Imágenes subidas por usuarios (si algún día se agregan)
uploads/

# Herramientas del editor / asistente
.impeccable/
.vscode/

