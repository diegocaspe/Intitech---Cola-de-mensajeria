# Plantilla de configuración de Inti Tech.
# Copia este archivo a .env (cp .env.example .env) y reemplaza TODOS los valores de ejemplo.
# El archivo .env tiene secretos reales: nunca lo subas a git (ya está en .gitignore).
# Para generar claves aleatorias:  python -c "import secrets; print(secrets.token_hex(32))"

# --- PostgreSQL (obligatorio) ---
# Solo se aplican al crear el volumen de datos por primera vez. Para cambiarlos después ver README → Configuración.
POSTGRES_DB=tienda
POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambia_esta_clave_de_postgres

# --- RabbitMQ (obligatorio) ---
# Usuario de api, relay, worker y mailer. En la laptop también es el del panel web http://localhost:15672
# En el servidor NO entra al panel web (no tiene tags): solo AMQP. Ahí, mínimo 20 caracteres.
RABBITMQ_USER=inti
RABBITMQ_PASS=cambia_esta_clave_de_rabbitmq

# --- Panel de RabbitMQ público (solo en el servidor: .env.production) ---
# https://<PUBLIC_DOMAIN>/rabbitmq/ pasa por dos candados. En la laptop no se usan: puedes dejarlas comentadas.
# Claves: 20 caracteres o más, aleatorias:  python -c "import secrets; print(secrets.token_hex(24))"
#
# Candado 1, Caddy (/rabbitmq/acceso). Se guarda el HASH bcrypt, nunca la clave. Generarlo (ver README):
#   docker run --rm -it caddy:2 caddy hash-password
# El hash tiene "$": va ENTRE COMILLAS SIMPLES o docker compose lo estropea.
# CADDY_RABBITMQ_USER=puerta
# CADDY_RABBITMQ_HASH='$2a$14$...pega_aqui_el_hash...'
# Token de la cookie que entrega la puerta (32+ caracteres, solo letras y números):
#   python -c "import secrets; print(secrets.token_hex(32))"
# CADDY_RABBITMQ_COOKIE=
#
# Candado 2, login de RabbitMQ: usuario de SOLO LECTURA (tag monitoring; configure "^$", write "^$", read ".*").
# También lo usa la api para leer las estadísticas de las colas.
# RABBITMQ_MONITOR_USER=monitor
# RABBITMQ_MONITOR_PASS=
#
# Administrador de RabbitMQ (purgar, publicar, mover de la DLQ): SOLO por túnel SSH. En el panel público Caddy
# deja todo en solo lectura aunque se entre con este usuario.
# RABBITMQ_ADMIN_USER=jefe
# RABBITMQ_ADMIN_PASS=
#
# Los tres usuarios de RabbitMQ deben ser distintos. deploy/rabbitmq/arranque.sh los crea o actualiza en cada arranque.

# --- API (obligatorio) ---
# Firma las sesiones de los usuarios: larga y aleatoria (64 caracteres hex con el comando de arriba).
# La API se niega a arrancar si tiene menos de 32 caracteres o sigue siendo un valor de ejemplo.
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
# Cuenta de administrador: se crea o actualiza en cada arranque de la API.
# ADMIN_PASSWORD: mínimo 10 caracteres y sin palabras de ejemplo (cambia, admin, password...) o la API no arranca.
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=cambia_esta_clave_de_admin

# --- Dirección pública (opcional) ---
# Base del QR del panel y de los enlaces de los correos. Vacía en la laptop: iniciar.ps1 detecta la IP de la Wi-Fi.
# En el servidor (.env.production) pon la URL con HTTPS con que entra el público, sin "/" al final:
# PUBLIC_BASE_URL=https://3-214-91-208.sslip.io
# Si empieza con https://, la cookie de sesión lleva Secure (solo viaja cifrada).
PUBLIC_BASE_URL=

# --- Dominio para HTTPS (solo en el servidor) ---
# Lo usa Caddy (docker-compose.prod.yml) para pedir el certificado de Let's Encrypt. sslip.io convierte el nombre en
# la IP (3-214-91-208.sslip.io -> 3.214.91.208), así no hace falta comprar un dominio. En la laptop no se usa.
# PUBLIC_DOMAIN=3-214-91-208.sslip.io

# --- Correos (los envía el contenedor mailer) ---
# true: envía de verdad por Gmail. false: solo escribe "correo simulado a ..." en el log del mailer
EMAIL_ENABLED=false
# Con EMAIL_ENABLED=true son obligatorias. Contraseña de aplicación de Google (requiere verificación en 2 pasos):
# https://myaccount.google.com/apppasswords  (16 letras; los espacios se ignoran)
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=tu_clave_de_16_letras
