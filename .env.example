# Plantilla de configuración de Inti Tech.
# Copia este archivo a .env (cp .env.example .env) y reemplaza TODOS los valores de ejemplo.
# El archivo .env tiene secretos reales: nunca lo subas a git (ya está en .gitignore).
# Para generar claves aleatorias:  python -c "import secrets; print(secrets.token_hex(32))"

# --- PostgreSQL (obligatorio) ---
# Solo se aplican al crear el volumen de datos por primera vez. Para cambiarlos después ver README → Configuración.
POSTGRES_DB=tienda
POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambia_esta_clave_de_postgres

# --- RabbitMQ (obligatorio) ---
# También son el usuario y la clave del panel web http://localhost:15672
RABBITMQ_USER=inti
RABBITMQ_PASS=cambia_esta_clave_de_rabbitmq

# --- API (obligatorio) ---
# Firma las sesiones de los usuarios: larga y aleatoria (64 caracteres hex con el comando de arriba)
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
# Cuenta de administrador: se crea o actualiza en cada arranque de la API
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=cambia_esta_clave_de_admin

# --- Correos (los envía el contenedor mailer) ---
# true: envía de verdad por Gmail. false: solo escribe "correo simulado a ..." en el log del mailer
EMAIL_ENABLED=false
# Con EMAIL_ENABLED=true son obligatorias. Contraseña de aplicación de Google (requiere verificación en 2 pasos):
# https://myaccount.google.com/apppasswords  (16 letras; los espacios se ignoran)
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=tu_clave_de_16_letras
